<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>goldmansachs</groupId>
    <artifactId>Event-Driven-Order-Pipeline</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Event-Driven-Order-Pipeline</name>

    <modules>
        <!-- API Gateway: Single entry point for all external client requests -->
        <!-- Routes requests to appropriate microservices based on path patterns -->
        <!-- Leverages Consul service discovery for dynamic routing -->
        <module>api-gateway</module>
        
        <!-- Microservices: Core business logic services -->
        <module>order-service</module>
        <module>settlement-service</module>
        <module>reconciliation-service</module>
        <module>user-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <lombok.version>1.18.48</lombok.version>
    </properties>

    <!-- Dependency Management: Spring Cloud Bill of Materials (BOM) for version alignment -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud provides coordinated versions for all cloud-related dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            
            <!-- Lombok: Ensure consistent version across all modules -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Global Dependencies: Available to all modules (order-service, settlement-service, etc.) -->
    <dependencies>
        <!-- Spring Cloud Consul: Service Discovery and Configuration Management
             Provides automatic service registration/deregistration and health checks.
             When a service starts, it registers itself with Consul. When it stops, it deregisters.
             Other services can then discover and communicate with it via Consul DNS or API.
        -->
        <!-- Spring Cloud Consul Discovery: Service registration and discovery
             All microservices register with Consul for dynamic service discovery.
             Version managed by Spring Cloud BOM.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-consul-discovery</artifactId>
        </dependency>

        <!-- Spring Boot Starter Web: Provides RestTemplate and web support
             RestTemplate will be enhanced with load balancing via Consul.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <!-- Build Configuration: Lombok annotation processing for services that need it -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Maven Compiler Plugin: Configure Lombok annotation processing -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <release>17</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
